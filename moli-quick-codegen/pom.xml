<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.bingchunmoli</groupId><artifactId>moli-quick-spring-boot-starter</artifactId><version>1.0.13-bate</version></parent>
  <artifactId>moli-quick-codegen</artifactId><packaging>pom</packaging>
  <description>Shared MyBatis code generation tools</description>
  <modules>
    <module>moli-quick-codegen-core</module>
    <module>moli-quick-codegen-cli</module>
    <module>moli-quick-codegen-maven-plugin</module>
    <module>moli-quick-codegen-spring-boot-starter</module>
    <module>moli-quick-codegen-app</module>
  </modules>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><codegen.ui.skip>false</codegen.ui.skip></properties>
  <dependencyManagement><dependencies>
    <dependency><groupId>com.bingchunmoli</groupId><artifactId>moli-quick-codegen-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.bingchunmoli</groupId><artifactId>moli-quick-codegen-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.freemarker</groupId><artifactId>freemarker</artifactId><version>2.3.34</version></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>4.7.7</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.22.4</version></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version></plugin>
  </plugins></pluginManagement></build>
</project>
